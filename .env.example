# Copy this file to .env for local use. On your host (Render etc.), add these as environment variables instead.

# Set to "production" on the live server
NODE_ENV=

# Any long random string. Keep it secret. Changing it logs everyone out.
SESSION_SECRET=

# Google sign-in: the OAuth Client ID from Google Cloud (Google Auth Platform → Clients). Not a secret.
GOOGLE_CLIENT_ID=

# Only emails from these domains can log in (comma-separated)
ALLOWED_DOMAINS=srmist.edu.in

# Login codes by email, option 1 (free, no domain needed): a Gmail account with 2-Step Verification
# and an App Password from https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Login codes by email, option 2 (needs your own domain). Resend (https://resend.com) API key for sending login codes.
# Leave empty locally: codes are printed in the terminal instead.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend
EMAIL_FROM=

# TURN server so video works on campus Wi-Fi / mobile data (e.g. Metered or Cloudflare)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Moderation: this many different people reporting someone within 7 days = ban for BAN_HOURS
REPORTS_TO_BAN=3
BAN_HOURS=24
